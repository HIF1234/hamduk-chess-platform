# Copy to .env.local for local development (never commit real values).
# On Vercel, set these in Project Settings -> Environment Variables.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL/key again, exposed to the browser at build time
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway (coach, assistant, weakness reports, Coach Verbal Review)
AI_GATEWAY_API_KEY=
# Optional: override the default model (an ID from https://ai-gateway.vercel.sh/v1/models)
AI_GATEWAY_MODEL=

# Paystack (subscriptions, tournament entry, coach bookings)
PAYSTACK_SECRET_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
