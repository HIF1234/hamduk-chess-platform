# Copy to .env.local for local development (never commit real values).
# On Vercel, set these in Project Settings -> Environment Variables.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL/key again, exposed to the browser at build time
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI explanations (coach, assistant, weakness reports, Coach Verbal Review).
# Free option: a Google AI Studio key calls Gemini directly on Google's free tier.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model ID (defaults to gemini-3.6-flash)
GOOGLE_AI_MODEL=
# Fallback when no Google key is set: Vercel AI Gateway
AI_GATEWAY_API_KEY=
# Optional: override the default model (an ID from https://ai-gateway.vercel.sh/v1/models)
AI_GATEWAY_MODEL=

# Paystack (subscriptions, tournament entry, coach bookings)
PAYSTACK_SECRET_KEY=

# Upstash Redis (presence, Puzzle Storm, correspondence, API keys, rate limiting).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduler: bearer token Supabase pg_cron sends to /api/cron/tick (also stored in Supabase Vault)
CRON_SECRET=

# Email (Resend). Supabase auth emails use Resend SMTP, configured in the Supabase dashboard.
RESEND_API_KEY=
EMAIL_FROM="Hamduk Chess <no-reply@hamduk.com.ng>"
